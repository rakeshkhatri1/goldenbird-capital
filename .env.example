# Copy to .env and fill in. Never commit .env.

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=goldenbird-nse-engine
# Optional if R2_ACCOUNT_ID is set:
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# Public HTTPS prefix for browser fetches (R2 ui/ or CDN). Empty = relative paths.
DATA_BASE_URL=

# --- Gemini ---
GEMINI_API_KEY=
# Or rotate several keys:
# GEMINI_API_KEYS=key1,key2
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Zerodha (optional; live market later) ---
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
